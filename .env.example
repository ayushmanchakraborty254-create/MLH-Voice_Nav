# ===================================================
# VoiceDOM Environment Configuration
# ===================================================

# Groq Open-Weight Inference API Key (Whisper Large v3 + Qwen 2.5 / 3.8-27B)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
WHISPER_MODEL=whisper-large-v3

# Default Language (en | bn | mr | hi)
DEFAULT_LANGUAGE=en

# Client Widget UI Preferences
ENABLE_SOUNDWAVE=true
ENABLE_RADAR_HIGHLIGHT=true
